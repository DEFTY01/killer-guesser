# Environment variables — copy to .env.local and fill in values

# ── Turso (libSQL) ────────────────────────────────────────────────
# Remote Turso database (production / staging):
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Local SQLite file (development — no Turso account needed):
# When DATABASE_URL is not set the app falls back to file:local.db
# automatically.  Run `npm run db:push` once to create the schema.
# DATABASE_URL=file:local.db

# ── Auth.js (admin session) ───────────────────────────────────────
# Generate with: openssl rand -base64 33
AUTH_SECRET=
AUTH_URL=http://localhost:3000

ADMIN_PASSWORD=

# ── Ably (real-time pub/sub) ──────────────────────────────────────
# Server-side API key — keep private, never expose to the browser
ABLY_API_KEY=
